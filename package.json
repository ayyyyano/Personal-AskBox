{
  "name": "personal-askbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "next start",
    "lint": "eslint .",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && wrangler deploy --domain askbox.nekro.top",
    "db:local": "wrangler d1 execute askbox-db --local --file=./db/schema.sql",
    "db:remote": "wrangler d1 execute askbox-db --remote --file=./db/schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply askbox-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply askbox-db --remote"
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20261004.1",
    "@mdui/icons": "1.0.4",
    "@opennextjs/cloudflare": "1.20.8",
    "algoliasearch": "^5.59.0",
    "marked": "^18.0.14",
    "mdui": "2.1.5",
    "nanoid": "6.0.1",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "16.3.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  }
}
