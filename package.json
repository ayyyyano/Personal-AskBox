{
  "name": "personal-askbox",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/next.mjs dev",
    "build": "node scripts/next.mjs build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/public-assets.test.mjs tests/build-dependencies.test.mjs tests/markdown.test.ts",
    "cf:build": "opennextjs-cloudflare build && node scripts/prepare-public-assets.mjs",
    "cf:preview": "pnpm run cf:build && wrangler dev",
    "cf:deploy": "pnpm run cf:build && wrangler deploy --domain askbox.nekro.top",
    "db:local": "wrangler d1 execute askbox-db --local --file=./db/schema.sql",
    "db:remote": "wrangler d1 execute askbox-db --remote --file=./db/schema.sql",
    "db:migrate:local": "wrangler d1 migrations apply askbox-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply askbox-db --remote"
  },
  "dependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@mdui/icons": "1.0.4",
    "@opennextjs/cloudflare": "1.20.16",
    "algoliasearch": "^5.61.0",
    "marked": "^18.1.3",
    "mdui": "2.1.5",
    "nanoid": "6.0.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "16.4.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.5",
    "htmlparser2": "12.0.0",
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "wrangler": "4.157.0"
  }
}
